{
  "name": "@accountability/public-accountability-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Accountability Machine: orchestration engine (E00) and integrated application over the fourteen accountability engines",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-foundation.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm run validate && npm test",
    "build": "tsc -p tsconfig.build.json",
    "engines:link": "node scripts/bootstrap-engines.mjs --link ..",
    "engines:install": "node scripts/bootstrap-engines.mjs",
    "engines:pin": "node scripts/bootstrap-engines.mjs --pin ..",
    "migrate": "node src/app/main.ts migrate",
    "bootstrap-admin": "node src/app/main.ts bootstrap-admin",
    "start": "node src/app/main.ts serve",
    "worker": "node src/app/main.ts worker"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
