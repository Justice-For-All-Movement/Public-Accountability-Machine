# Copy to .env (never commit it) and fill in. Values here are placeholders, not secrets.
DATABASE_URL=postgresql://pam:CHANGE_ME@127.0.0.1:5432/pam
PORT=8080
HOST=127.0.0.1
PAM_DATA_DIR=./data                       # object storage (fs) and temporary work
PAM_ENGINES_DIR=./engines
PAM_PUBLIC_URL=http://127.0.0.1:8080
# Secrets: generate with `openssl rand -base64 32`
IDENTITY_KEY_ENCRYPTION_KEY=
IDENTITY_BOOTSTRAP_TOKEN=                  # only needed for HTTP bootstrap; the CLI bootstrap does not use it
EVIDENCE_MASTER_KEY=
CORRESPONDENCE_SECRET_KEY=
RELEASE_DOWNLOAD_SECRET=
DISCOVERY_CREDENTIAL_KEY=
# Malware scanning of evidence: a ClamAV signature directory, or explicitly accept structural checks only.
CLAMAV_DATABASE_DIR=
# EVIDENCE_SCAN_POLICY=structural_only
DISCOVERY_USER_AGENT=PAM-Research/0.1 (automated research assistant; contact: research@example.org)
PAM_JURISDICTION_PACKS_DIR=./deployment/jurisdiction-packs   # private deployment data
# Intake (E02) link per PAM organization id; the token is an intake service credential WITHOUT protected-field scope.
# PAM_INTAKE_LINKS={"<organization id>":{"baseUrl":"https://intake.example.org/api/v1","token":"sicwe_..."}}
# PAM_INTAKE_PUBLIC_URL=https://intake.example.org
# Object storage on S3-compatible service instead of the filesystem:
# OBJECT_STORE=s3
# S3_ENDPOINT= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PREFIX=pam/
# First administrator (used once by `npm run bootstrap-admin`):
PAM_ADMIN_LOGIN=admin@example.org
PAM_ADMIN_PASSWORD=
PAM_ORG_NAME=Example Organization
